{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs"
  ],
  "description": "No CI runs on this repository's pull requests, so no rule here merges automatically: with ignoreTests false Renovate would wait for checks that never report. Add the non-major automerge rule once a workflow checks pull requests.",
  "reviewers": [
    "martinfrancois"
  ],
  "labels": [
    "dependencies"
  ],
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "pinDigests": true,
  "rangeStrategy": "pin",
  "dependencyDashboardApproval": false,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMinorPatch": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [],
    "updateNotScheduled": true,
    "groupName": null,
    "groupSlug": null
  },
  "packageRules": [
    {
      "description": "jmh-core and jmh-generator-annprocess share the jmh.version property, and the annotation processor generates code against the core it was released with, so they move in one pull request.",
      "matchPackageNames": [
        "org.openjdk.jmh:**"
      ],
      "groupName": "JMH",
      "groupSlug": "jmh"
    },
    {
      "description": "A major update can change what the demo shows on stage, so it waits for a review.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major update"
      ]
    }
  ]
}
